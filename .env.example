# 预置唯一账号（MVP 无注册）
JINYU_AUTH_USERNAME=jinyu
JINYU_AUTH_PASSWORD=change-me

# Session 加密密钥（生产请换成长随机串）
JINYU_SESSION_SECRET=change-me-to-a-long-random-string

# LLM — DeepSeek 官方 API（Chat Completions）
# 真 Key 只写在 .env.local，不要提交仓库
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# 本地开发默认走真 LLM；仅测试/CI 设 true
LLM_USE_FAKE=false
# 直播起名：第一路发出去多少毫秒以后发其余几路，不设是 0（几路一起发）
# FAST_HEDGE_MS=0
# 直播一轮一共发几路（每路一组不同的起手字，回来的都合起来用）：不设是 2；设 3 更快一点，调用量多一半
# FAST_LANES=2
# 直播首推从哪来：不设是 model（模型现起）；设 library 回到「首推从名字库挑」
# FAST_PRIMARY=model
# 直播起名六维闸门最低分：不设是 90（打分榜「非常优秀」线，系统起的名字放到打分榜上不会是 89）；设 85 回到 11-05 以前的线
# FAST_SIX_MIN=90
