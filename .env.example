# 预置唯一账号（MVP 无注册）
JINYU_AUTH_USERNAME=jinyu
JINYU_AUTH_PASSWORD=change-me

# Session 加密密钥（生产请换成长随机串）
JINYU_SESSION_SECRET=change-me-to-a-long-random-string

# LLM — 本机 OpenAI 兼容网关（Chat Completions）
# 真 Key 只写在 .env.local，不要提交仓库
LLM_PROVIDER=magpie
LLM_BASE_URL=http://127.0.0.1:3425/v1
LLM_API_KEY=
LLM_MODEL=opendesign/deepseek-v4.1-flash

# 本地开发默认走真 LLM；仅测试/CI 设 true
LLM_USE_FAKE=false
